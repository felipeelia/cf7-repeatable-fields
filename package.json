{
	"name": "cf7-repeatable-fields",
	"version": "2.0.2",
	"description": "Repeatable Fields Add-on for Contact Form 7",
	"license": "GPL-3.0+",
	"main": "Gruntfile.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/felipeelia/cf7-repeatable-fields"
	},
	"bugs": {
		"url": "https://github.com/felipeelia/cf7-repeatable-fields/issues"
	},
	"author": "Felipe Elia",
	"homepage": "https://github.com/felipeelia/cf7-repeatable-fields#readme",
	"engines": {
		"node": "^24.15.0 || >=26.0.0",
		"npm": ">=11.0.0"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@wordpress/env": "^12.1.0",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/scripts": "^37.1.0",
		"@wp-playground/cli": "3.1.64",
		"eslint": "^10.15.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react-hooks": "^7.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1"
	},
	"lint-staged": {
		"*.php": [
			"./vendor/bin/phpcs --extensions=php --runtime-set testVersion 8.3- -s"
		],
		"*.{js,mjs}": [
			"wp-scripts lint-js"
		]
	},
	"scripts": {
		"prepare": "husky",
		"build": "wp-scripts build assets/js/scripts.js --webpack-no-externals --output-path=dist",
		"env": "wp-env",
		"format": "wp-scripts format ./assets",
		"lint:js": "wp-scripts lint-js --ext=js,mjs",
		"lint:php": "./vendor/bin/phpcs --extensions=php --runtime-set testVersion 8.3- -s",
		"lint": "npm run lint:js && npm run lint:php",
		"start": "wp-scripts start assets/js/scripts.js --webpack-no-externals --output-path=dist",
		"e2e:open": "npm run build && playwright test --ui",
		"e2e:run": "npm run build && playwright test",
		"e2e:serve": "npm run build && node tests/e2e/server.mjs"
	},
	"overrides": {
		"@wp-playground/storage": {
			"isomorphic-git": "^1.44.14"
		},
		"copy-webpack-plugin": {
			"serialize-javascript": "^7.1.4"
		}
	}
}
