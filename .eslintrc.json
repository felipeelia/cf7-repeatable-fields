{
	"extends": [
		"plugin:@wordpress/eslint-plugin/recommended"
	],
	"env": {
		"jquery": true
	},
	"ignorePatterns": [
		"vendor/*",
		"dist/*",
		"playwright-report/**",
		"test-results/**"
	],
	"rules": {
		"import/no-extraneous-dependencies": [
			"error",
			{
				"devDependencies": true
			}
		]
	}
}
