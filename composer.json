{
	"name": "felipeelia/cf7-repeatable-fields",
	"description": "Contact Form 7 – Repeatable Fields",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"php": ">=8.3",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"10up/phpcs-composer": "^3.0.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"wpackagist-plugin/contact-form-7": "6.2.5",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3.0"
		}
	},
	"extra": {
		"installer-paths": {
			"vendor/{$name}/": [
				"type:wordpress-plugin",
				"type:wordpress-theme"
			]
		}
	},
	"scripts": {
		"test": "phpunit",
		"setup-local-tests": "bash bin/install-wp-tests.sh cf7_rf_test root password 127.0.0.1 7.1.4 true"
	}
}
